{
  "openapi": "3.1.0",
  "info": {
    "title": "Example API",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "https://example.com" }
  ],
  "paths": {
    "/api/reports/{id}": {
      "get": {
        "operationId": "getReport",
        "summary": "Retrieve a paid inspection report.",
        "x-payment-info": {
          "intent": "charge",
          "method": "stripe",
          "amount": "4.99",
          "currency": "USD"
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Report returned after payment." },
          "402": { "description": "Payment required — negotiate via MPP." }
        }
      }
    }
  }
}
